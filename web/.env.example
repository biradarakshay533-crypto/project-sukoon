# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps (Google Cloud console). Leave empty to use free OpenStreetMap.
# Restrict the key to the website's domain in the console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for the red pins (Google Maps Platform > Map management). Optional while testing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
