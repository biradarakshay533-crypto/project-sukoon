# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps (Google Cloud console). Leave empty to use free OpenStreetMap.
# Restrict the key to the website's domain in the console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for the red pins (Google Maps Platform > Map management). Optional while testing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Push notifications for spa owners. Make a pair once with:
#   npx web-push generate-vapid-keys
# The private key is secret: only in .env.local and Vercel, never in Git.
# Leave all three empty to turn push notifications off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://sukoonam.in
